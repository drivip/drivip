{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./src/*"],
      "@drivip/types": ["../packages/types/src/index.ts"],
      "@drivip/supabase": ["../packages/supabase/src/index.ts"]
    }
  },
  "include": ["src"]
}
